      const sizeMenu = document.getElementById('sizeMenu');
      const sizeWrap = document.getElementById('sizeWrap');
      const btnExportMenu = document.getElementById('btnExportMenu');
      const exportMenu = document.getElementById('exportMenu');
      const exportWrap = document.getElementById('exportWrap');

      const camEase = document.getElementById('camEase');
      const camScale = document.getElementById('camScale');
      const camX = document.getElementById('camX');
      const camY = document.getElementById('camY');

      const scenesPreviewCanvas = document.getElementById('scenesPreviewCanvas');
      const spCtx = scenesPreviewCanvas.getContext('2d');
      const scenesBoard = document.getElementById('scenesBoard');
      const scenesGrid = document.getElementById('scenesGrid');
      const scenesZoomSlider = document.getElementById('scenesZoomSlider');
      const scenesScrubber = document.getElementById('scenesScrubber');
      const scenesFrameReadout = document.getElementById('scenesFrameReadout');
