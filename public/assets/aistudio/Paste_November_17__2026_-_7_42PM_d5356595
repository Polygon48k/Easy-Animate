<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Animator</title>
  <style>
    :root {
      --bg-dark: #000000;
      --bg-panel: #080808;
      --bg-elevated: #121212;
      --border: #262626;
      --text: #f0f0f0;
      --text-muted: #888888;
      --accent: #e5e5e5;
      --accent-hover: #ffffff;
      --cel-color: #4ade80;
      --bg-layer-color: #a3a3a3;
      --mouth-color: #f472b6;
      --audio-color: #c084fc;
      --cam-color: #fbbf24;
      --danger: #ef4444;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    *::-webkit-scrollbar {
      display: none;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg-dark);
      color: var(--text);
      display: flex;
      flex-direction: column;
      font-size: 12px;
    }

    /* Top Header */
    header {
      height: 42px;
      background: var(--bg-panel);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 10px;
      gap: 8px;
      flex-shrink: 0;
    }

    .toolbar-group {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .pill-group {
      display: inline-flex;
      align-items: center;
      background: var(--bg-dark);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 2px;
      gap: 2px;
    }

    button, select {
      background: var(--bg-elevated);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 4px 7px;
      font-size: 11px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
      transition: background 0.12s, border-color 0.12s, color 0.12s;
    }

    button:hover, select:hover {
      background: #1e1e1e;
      border-color: #3f3f3f;
    }

    button.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #000000;
      font-weight: 600;
    }

    button.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #000000;
      font-weight: 600;
    }

    button.primary:hover {
      background: var(--accent-hover);
    }

    button.export-btn {
      background: #f0f0f0;
      border-color: #f0f0f0;
      color: #000000;
      font-weight: 700;
    }

    button.export-btn:hover {
      background: #ffffff;
      border-color: #ffffff;
    }

    button.danger:hover {
      background: rgba(239, 68, 68, 0.2);
      border-color: var(--danger);
      color: #fca5a5;
    }

    button.recording {
      background: var(--danger);
      border-color: var(--danger);
      color: #ffffff;
      font-weight: 700;
      animation: pulseRec 1s infinite;
    }

    @keyframes pulseRec {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.65; }
    }

    .mini-btn {
      padding: 2px 5px;
      font-size: 10px;
      border-radius: 4px;
    }

    .dropdown-wrap {
      position: relative;
      display: inline-flex;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      background: var(--bg-elevated);
      border: 1px solid #3a3a3a;
      border-radius: 8px;
      padding: 4px;
      min-width: 195px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.85);
      z-index: 120;
      display: none;
      flex-direction: column;
      gap: 2px;
    }

    .dropdown-menu.open {
      display: flex;
    }

    .dropdown-menu button {
      width: 100%;
      justify-content: flex-start;
      background: transparent;
      border: none;
      padding: 7px 10px;
      border-radius: 5px;
      font-size: 12px;
    }

    .dropdown-menu button:hover {
      background: var(--accent);
      color: #000000;
    }

    /* Page Switch Views */
    .editor-view {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow: hidden;
    }

    .editor-view.hidden-view,
    .scenes-view.hidden-view {
      display: none;
    }

    /* Camera Popover Anchored Above Timeline Header */
    .cam-popover {
      position: absolute;
      bottom: calc(100% + 8px);
      left: 0;
      width: 215px;
      background: var(--bg-panel);
      border: 1px solid #3a3a3a;
      border-radius: 8px;
      padding: 10px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.85);
      z-index: 110;
      display: none;
      flex-direction: column;
      gap: 9px;
    }

    .cam-popover.open {
      display: flex;
    }

    /* Main Workspace */
    .workspace {
      flex: 1;
      display: flex;
      min-height: 0;
      overflow: hidden;
    }

    /* Ultra-Slim Left Tool Dock (2-wide palette) */
    .left-dock {
      width: 54px;
      background: var(--bg-panel);
      border-right: 1px solid var(--border);
      padding: 6px 4px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      overflow: hidden;
      flex-shrink: 0;
    }

    .section-title {
      font-size: 8px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      color: var(--text-muted);
      margin-bottom: 3px;
      text-align: center;
    }

    .tool-stack {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .tool-btn {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 5px 1px;
      font-weight: 500;
      font-size: 8.5px;
      gap: 2px;
      width: 100%;
    }

    .tool-btn svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .brush-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    input[type="color"] {
      width: 100%;
      height: 18px;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: none;
      padding: 0;
      cursor: pointer;
    }

    .swatches {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 3px;
      width: 100%;
    }

    .swatch {
      width: 100%;
      aspect-ratio: 1;
      border-radius: 3px;
      border: 1px solid rgba(255,255,255,0.22);
      cursor: pointer;
    }

    .size-box {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .gap-btn {
      width: 100%;
      justify-content: center;
      padding: 3px 1px;
      font-size: 8.5px;
    }

    input[type="range"] {
      width: 100%;
      min-width: 0;
      accent-color: #d4d4d4;
      cursor: pointer;
    }

    .control-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      margin-bottom: 5px;
    }

    .control-row label {
      color: var(--text-muted);
      font-size: 11px;
      min-width: 42px;
    }

    .val-badge {
      font-variant-numeric: tabular-nums;
      color: var(--text);
      font-size: 11px;
      min-width: 34px;
      text-align: right;
    }

    /* Full-Area Stage */
    .stage-container {
      flex: 1;
      background: #000000;
      position: relative;
      overflow: hidden;
      min-width: 0;
      min-height: 0;
    }

    .stage-container.drop-active {
      outline: 2px dashed var(--cel-color);
      outline-offset: -4px;
    }

    canvas#stage {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: none;
      cursor: crosshair;
      image-rendering: -moz-crisp-edges;
      image-rendering: -webkit-crisp-edges;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    .stage-top-left {
      position: absolute;
      top: 10px;
      left: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      z-index: 6;
    }

    .stage-badge {
      background: rgba(8, 8, 8, 0.9);
      border: 1px solid var(--border);
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11px;
      color: var(--text-muted);
      pointer-events: none;
    }

    /* Floating Mouth Viseme Switcher Widget (Frame + Left/Right Arrows) */
    .mouth-widget {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: rgba(10, 10, 10, 0.94);
      border: 1px solid #3a3a3a;
      border-radius: 10px;
      padding: 7px 8px;
      display: none;
      flex-direction: column;
      gap: 6px;
      z-index: 8;
      box-shadow: 0 10px 26px rgba(0, 0, 0, 0.85);
    }

    .mouth-widget.open {
      display: flex;
    }

    .mouth-cycler {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .mouth-arrow-btn {
      width: 26px;
      height: 54px;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      padding: 0;
      background: #141414;
    }

    .mouth-frame-box {
      width: 84px;
      height: 62px;
      background: #ffffff;
      border: 2px solid var(--mouth-color);
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      cursor: pointer;
    }

    .mouth-frame-box canvas {
      width: 100%;
      height: 100%;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    .mouth-frame-label {
      position: absolute;
      bottom: 2px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(0, 0, 0, 0.82);
      color: #ffffff;
      font-size: 10px;
      font-weight: 700;
      padding: 1px 6px;
      border-radius: 999px;
      pointer-events: none;
    }

    .mouth-widget-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px;
    }

    /* Mouth Viseme Sheet Popover (All 8 shapes + Clear/Reset) */
    .mouth-sheet-pop {
      position: absolute;
      bottom: calc(100% + 8px);
      right: 0;
      width: 274px;
      background: var(--bg-panel);
      border: 1px solid #3a3a3a;
      border-radius: 10px;
      padding: 9px;
      box-shadow: 0 14px 36px rgba(0, 0, 0, 0.9);
      display: none;
      flex-direction: column;
      gap: 8px;
      z-index: 20;
    }

    .mouth-sheet-pop.open {
      display: flex;
    }

    .mouth-sheet-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 5px;
    }

    .mouth-slot {
      background: #ffffff;
      border: 2px solid #262626;
      border-radius: 5px;
      aspect-ratio: 4 / 3;
      position: relative;
      cursor: pointer;
      overflow: hidden;
      padding: 0;
    }

    .mouth-slot.active {
      border-color: var(--mouth-color);
      box-shadow: 0 0 0 1px var(--mouth-color);
    }

    .mouth-slot canvas {
      width: 100%;
      height: 100%;
      display: block;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    .mouth-slot span {
      position: absolute;
      bottom: 1px;
      left: 2px;
      background: rgba(0,0,0,0.8);
      color: #fff;
      font-size: 8.5px;
      font-weight: 700;
      padding: 0 3px;
      border-radius: 2px;
    }

    /* Bottom Timeline */
    .timeline-panel {
      height: 144px;
      background: var(--bg-panel);
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      overflow: visible;
    }

    .timeline-header {
      height: 36px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 10px;
      gap: 6px;
      flex-shrink: 0;
      position: relative;
    }

    .timeline-header-center {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .timeline-body {
      flex: 1;
      display: flex;
      overflow: hidden;
      min-height: 0;
    }

    .track-labels {
      width: 212px;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      background: var(--bg-panel);
    }

    .track-label-loop {
      height: 18px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 8px;
      font-size: 10px;
      color: var(--text-muted);
    }

    .track-label-spacer {
      height: 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      padding: 0 8px;
      font-size: 10px;
      color: var(--text-muted);
    }

    .track-label {
      flex: 1;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 8px;
      font-size: 11px;
      font-weight: 500;
      gap: 4px;
      border-left: 3px solid transparent;
    }

    .track-label.active-draw-layer {
      border-left-color: #ffffff;
      background: rgba(255, 255, 255, 0.06);
    }

    .track-label.hidden-track {
      display: none;
    }

    .track-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      overflow: hidden;
      cursor: pointer;
    }

    .track-tag i {
      width: 8px;
      height: 8px;
      border-radius: 2px;
      display: inline-block;
      flex-shrink: 0;
    }

    .timeline-scroll {
      flex: 1;
      overflow-x: auto;
      overflow-y: hidden;
      position: relative;
      background: #050505;
      min-width: 0;
    }

    .timeline-grid {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      touch-action: none;
    }

    /* Loop Range Row */
    .loop-row {
      height: 18px;
      width: 100%;
      border-bottom: 1px solid var(--border);
      background: #000000;
      position: relative;
      cursor: crosshair;
      flex-shrink: 0;
    }

    .loop-selection-bar {
      position: absolute;
      top: 2px;
      bottom: 2px;
      background: rgba(255, 255, 255, 0.25);
      border-left: 2px solid #ffffff;
      border-right: 2px solid #ffffff;
      border-radius: 2px;
      pointer-events: none;
      display: none;
    }

    .loop-highlight-overlay {
      position: absolute;
      top: 18px;
      bottom: 0;
      background: rgba(255, 255, 255, 0.05);
      border-left: 1px dashed rgba(255, 255, 255, 0.45);
      border-right: 1px dashed rgba(255, 255, 255, 0.45);
      pointer-events: none;
      z-index: 2;
      display: none;
    }

    /* Ruler Row */
    .ruler-row {
      height: 24px;
      display: flex;
      width: 100%;
      border-bottom: 1px solid var(--border);
      background: #0f0f0f;
      flex-shrink: 0;
      cursor: ew-resize;
    }

    .ruler-cell {
      flex: 1 1 0;
      min-width: 0;
      border-right: 1px solid rgba(255,255,255,0.06);
      font-size: 10px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .ruler-cell.active {
      background: #e5e5e5;
      color: #000000;
      font-weight: 700;
    }

    .track-row {
      flex: 1;
      display: flex;
      width: 100%;
      border-bottom: 1px solid var(--border);
      position: relative;
      overflow: hidden;
    }

    .track-row.hidden-track {
      display: none;
    }

    #celTrackRow {
      cursor: pointer;
    }

    .frame-cell {
      flex: 1 1 0;
      min-width: 0;
      border-right: 1px solid rgba(255,255,255,0.05);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .frame-cell.current-col {
      background: rgba(255, 255, 255, 0.08);
    }

    /* Cel Span Pill Overlay */
    .cel-span-bar {
      position: absolute;
      top: 5px;
      bottom: 5px;
      background: rgba(74, 222, 128, 0.18);
      border: 1px solid rgba(74, 222, 128, 0.7);
      border-radius: 5px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5px;
      z-index: 1;
      cursor: ew-resize;
      overflow: hidden;
    }

    .cel-span-bar:hover {
      background: rgba(74, 222, 128, 0.3);
      border-color: var(--cel-color);
    }

    .cel-span-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--cel-color);
      flex-shrink: 0;
    }

    .cel-span-dot.blank {
      background: transparent;
      border: 2px solid var(--cel-color);
    }

    .cel-span-grip {
      width: 3px;
      height: 12px;
      border-radius: 2px;
      background: rgba(74, 222, 128, 0.85);
      flex-shrink: 0;
      margin-left: auto;
    }

    /* Mouth Viseme Keyframe Markers */
    #mouthTrackRow {
      background: #0a080a;
      cursor: pointer;
    }

    .mouth-key-pill {
      position: absolute;
      top: 5px;
      bottom: 5px;
      background: rgba(244, 114, 182, 0.2);
      border: 1px solid var(--mouth-color);
      border-radius: 4px;
      color: #fbcfe8;
      font-size: 9px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }

    /* Background Layer Track */
    #bgTrackRow {
      background: #0a0a0a;
      cursor: pointer;
    }

    #bgTrackRow.drop-active {
      background: rgba(255, 255, 255, 0.12);
      outline: 2px dashed #d4d4d4;
      outline-offset: -2px;
    }

    .bg-span-bar {
      position: absolute;
      inset: 5px 4px;
      background: rgba(163, 163, 163, 0.14);
      border: 1px solid rgba(163, 163, 163, 0.5);
      border-radius: 4px;
      display: flex;
      align-items: center;
      padding: 0 10px;
      font-size: 11px;
      color: #d4d4d4;
      pointer-events: none;
    }

    /* Audio Track & Waveform */
    #audioTrackRow {
      background: #080808;
      position: relative;
    }

    #audioTrackRow.drop-active {
      background: rgba(192, 132, 252, 0.15);
      outline: 2px dashed var(--audio-color);
      outline-offset: -2px;
    }

    .audio-empty-hint {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      color: var(--text-muted);
      pointer-events: none;
    }

    .audio-rec-badge {
      position: absolute;
      left: 8px;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(239, 68, 68, 0.9);
      color: #ffffff;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 999px;
      z-index: 3;
      pointer-events: none;
      display: none;
    }

    #audioWaveCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }

    .audio-clip-box {
      position: absolute;
      top: 4px;
      bottom: 4px;
      background: rgba(192, 132, 252, 0.14);
      border: 1px solid rgba(192, 132, 252, 0.75);
      border-radius: 4px;
      z-index: 2;
      cursor: grab;
      display: none;
    }

    .audio-clip-box.selected {
      border-color: #ffffff;
      box-shadow: 0 0 0 1px #ffffff;
    }

    .audio-clip-box:active {
      cursor: grabbing;
    }

    .audio-clip-label {
      position: absolute;
      top: 2px;
      left: 12px;
      right: 12px;
      font-size: 10px;
      color: #e9d5ff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      pointer-events: none;
      text-shadow: 0 1px 2px rgba(0,0,0,0.9);
    }

    .audio-trim-handle {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 10px;
      background: rgba(192, 132, 252, 0.45);
      cursor: ew-resize;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .audio-trim-handle::after {
      content: "";
      width: 2px;
      height: 12px;
      background: #f3e8ff;
      border-radius: 1px;
    }

    .audio-trim-handle.left {
      left: 0;
      border-radius: 3px 0 0 3px;
    }

    .audio-trim-handle.right {
      right: 0;
      border-radius: 0 3px 3px 0;
    }

    .audio-trim-handle:hover {
      background: rgba(192, 132, 252, 0.85);
    }

    /* Camera Keyframe Markers */
    .cam-bar {
      position: absolute;
      left: 0;
      right: 0;
      height: 5px;
      background: rgba(251, 191, 36, 0.35);
      top: 50%;
      transform: translateY(-50%);
    }

    .cam-diamond {
      width: 10px;
      height: 10px;
      background: var(--cam-color);
      transform: rotate(45deg);
      z-index: 1;
      box-shadow: 0 0 0 2px #050505;
    }

    .playhead-line {
      position: absolute;
      top: 18px;
      bottom: 0;
      width: 2px;
      margin-left: -1px;
      background: #ffffff;
      pointer-events: none;
      z-index: 5;
    }

    .playhead-cap {
      position: absolute;
      top: 0;
      left: -5px;
      width: 12px;
      height: 6px;
      background: #ffffff;
      border-radius: 0 0 3px 3px;
    }

    /* ==========================================
       SCENES / STORYBOARD PAGE
       ========================================== */
    .scenes-view {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #000000;
      min-height: 0;
      overflow: hidden;
    }

    .scenes-player-area {
      height: 44%;
      min-height: 180px;
      background: #050505;
      border-bottom: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10px 14px 8px;
      gap: 8px;
      flex-shrink: 0;
    }

    .scenes-preview-wrap {
      flex: 1;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 0;
    }

    canvas#scenesPreviewCanvas {
      max-width: 100%;
      max-height: 100%;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 4px;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    .scenes-player-bar {
      width: 100%;
      max-width: 820px;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .scenes-scrubber {
      flex: 1;
      height: 16px;
      background: #121212;
      border: 1px solid var(--border);
      border-radius: 4px;
      position: relative;
      cursor: ew-resize;
      overflow: hidden;
      display: flex;
    }

    .scenes-scrub-seg {
      height: 100%;
      border-right: 1px solid #333333;
      position: relative;
      overflow: hidden;
    }

    .scenes-scrub-playhead {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 2px;
      background: #ffffff;
      pointer-events: none;
    }

    .scenes-board-header {
      height: 38px;
      background: var(--bg-panel);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      flex-shrink: 0;
    }

    .scenes-board {
      flex: 1;
      overflow-y: auto;
      padding: 14px;
      background: #000000;
      --scene-card-w: 220px;
    }

    .scenes-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: flex-start;
    }

    .scene-card {
      width: var(--scene-card-w);
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      cursor: grab;
      transition: border-color 0.12s, transform 0.12s, opacity 0.12s;
    }

    .scene-card:active {
      cursor: grabbing;
    }

    .scene-card.selected {
      border-color: #ffffff;
      box-shadow: 0 0 0 1px #ffffff;
    }

    .scene-card.playing-now {
      border-color: var(--cel-color);
      box-shadow: 0 0 0 1px var(--cel-color);
    }

    .scene-card.drag-over {
      border-color: #ffffff;
      outline: 2px dashed #ffffff;
      transform: scale(1.02);
    }

    .scene-card.dragging {
      opacity: 0.4;
    }

    .scene-thumb-box {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #0d0d0d;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      border-bottom: 1px solid var(--border);
      position: relative;
    }

    .scene-thumb-box canvas {
      max-width: 100%;
      max-height: 100%;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    .scene-num-badge {
      position: absolute;
      top: 5px;
      left: 6px;
      background: rgba(0, 0, 0, 0.8);
      border: 1px solid #333333;
      color: #f0f0f0;
      font-size: 10px;
      padding: 1px 6px;
      border-radius: 4px;
      pointer-events: none;
    }

    .scene-meta {
      padding: 6px 8px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .scene-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px;
    }

    .scene-name-input {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text);
      font-size: 11px;
      font-weight: 600;
      padding: 2px 4px;
      border-radius: 4px;
      width: 100%;
      min-width: 0;
      user-select: text;
    }

    .scene-name-input:focus {
      outline: none;
      background: #141414;
      border-color: #444444;
    }

    .scene-actions-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px;
    }

    .scene-info-txt {
      font-size: 10px;
      color: var(--text-muted);
      white-space: nowrap;
    }

    /* Context Pop-out Menus */
    .context-menu {
      position: fixed;
      background: var(--bg-elevated);
      border: 1px solid #3a3a3a;
      border-radius: 8px;
      padding: 4px;
      min-width: 165px;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.85);
      z-index: 130;
      display: none;
      flex-direction: column;
      gap: 2px;
    }

    .context-menu button {
      width: 100%;
      justify-content: flex-start;
      background: transparent;
      border: none;
      padding: 6px 10px;
      border-radius: 5px;
      font-size: 12px;
    }

    .context-menu button:hover:not(:disabled) {
      background: var(--accent);
      color: #000000;
    }

    .context-menu button.ctx-danger:hover:not(:disabled) {
      background: var(--danger);
      color: #fff;
    }

    .context-menu button:disabled {
      opacity: 0.4;
      cursor: default;
    }

    .hint {
      font-size: 10.5px;
      color: var(--text-muted);
      line-height: 1.35;
    }
  </style>
</head>
<body>

  <header>
    <div class="toolbar-group">
      <div class="pill-group">
        <button id="btnModeEditor" class="active" style="border:none;">Editor</button>
        <button id="btnModeScenes" style="border:none;">Scenes</button>
      </div>
      <span id="activeSceneLabel" style="color:var(--text-muted); font-size:11px; margin-left:4px;">Scene 1</span>
    </div>

    <div class="toolbar-group" id="editorOnionGroup">
      <div class="pill-group" title="Onion Skinning (O)">
        <button id="btnOnion" style="border:none;">Onion: Off</button>
        <button id="btnOnionBefore" class="mini-btn active" style="border:none;" title="Show 1 Frame Before">Prev</button>
        <button id="btnOnionAfter" class="mini-btn" style="border:none;" title="Show 1 Frame After">Next</button>
      </div>
    </div>

    <div class="toolbar-group">
      <button id="btnLoadJson" title="Open project JSON">Load</button>
      <input type="file" id="fileInput" accept=".json" style="display:none" />

      <div class="dropdown-wrap" id="sizeWrap">
        <button id="btnCanvasSize" title="Change Canvas Resolution">📐 1280×720 ▾</button>
        <div class="dropdown-menu" id="sizeMenu">
          <button data-res="720x480">720 × 480 (SD)</button>
          <button data-res="1280x720">1280 × 720 (HD)</button>
          <button data-res="1920x1080">1920 × 1080 (Full HD)</button>
        </div>
      </div>

      <div class="dropdown-wrap" id="exportWrap">
        <button id="btnExportMenu" class="export-btn" title="Export Video, PNG Sequence, or Project">Export ▾</button>
        <div class="dropdown-menu" id="exportMenu">
          <button id="btnExportMp4">🎞 Export MP4 (.mp4)</button>
          <button id="btnExportWebm">🎬 Export WebM (.webm)</button>
          <button id="btnExportPngSeq">🖼 Export PNG Sequence (.zip)</button>
          <button id="btnSaveJson">💾 Export Project (.json)</button>
        </div>
      </div>
    </div>
  </header>

  <!-- ==========================================
       PAGE 1: SCENE EDITOR VIEW
       ========================================== -->
  <div class="editor-view" id="editorView">
    <div class="workspace">
      <!-- Slim Left Tool Dock (2-wide palette) -->
      <aside class="left-dock">
        <div>
          <div class="section-title">Tools</div>
          <div class="tool-stack">
            <button class="tool-btn active" data-tool="brush" title="Brush (B) — Right-click erases, [ / ] resizes">
              <svg viewBox="0 0 24 24">
                <path d="M18.37 2.63 14 7l-1.59-1.59a2 2 0 0 0-2.82 0L8 7l9 9 1.59-1.59a2 2 0 0 0 0-2.82L17 10l4.37-4.37a2.12 2.12 0 1 0-3-3Z"/>
                <path d="M9 8c-2 3-4 3.5-7 4l8 10c2-1 6-5 6-7"/>
              </svg>
              <span>Brush</span>
            </button>

            <button class="tool-btn" data-tool="eraser" title="Eraser (E) — [ / ] resizes">
              <svg viewBox="0 0 24 24">
                <path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"/>
                <path d="M22 21H7"/>
                <path d="m5 11 9 9"/>
              </svg>
              <span>Eraser</span>
            </button>

            <button class="tool-btn" data-tool="fill" title="Fill Bucket (F) — Right-click erases">
              <svg viewBox="0 0 24 24">
                <path d="m19 11-8-8-8.6 8.6a2 2 0 0 0 0 2.8l5.2 5.2c.8.8 2 .8 2.8 0L19 11Z"/>
                <path d="m5 2 5 5"/>
                <path d="M2 13h15"/>
                <path d="M22 20a2 2 0 1 1-4 0c0-1.6 1.7-2.4 2-4 .3 1.6 2 2.4 2 4Z"/>
              </svg>
              <span>Fill</span>
            </button>

            <button class="tool-btn" data-tool="moveCam" title="Move Layer (Left-drag) / Zoom Cam (Right-drag) / Pan Cam (Shift+drag)">
              <svg viewBox="0 0 24 24">
                <path d="M5 9l-3 3 3 3"/>
                <path d="M9 5l3-3 3 3"/>
                <path d="M15 19l-3 3-3-3"/>
                <path d="M19 9l3 3-3 3"/>
                <path d="M2 12h20"/>
                <path d="M12 2v20"/>
              </svg>
              <span>Move</span>
            </button>
          </div>
        </div>

        <div class="brush-box">
          <div class="section-title" style="margin-bottom:0;">Color</div>
          <input type="color" id="brushColor" value="#000000" />
          <div class="swatches">
            <div class="swatch" style="background:#000000" data-color="#000000"></div>
            <div class="swatch" style="background:#ef4444" data-color="#ef4444"></div>
            <div class="swatch" style="background:#3b82f6" data-color="#3b82f6"></div>
            <div class="swatch" style="background:#22c55e" data-color="#22c55e"></div>
            <div class="swatch" style="background:#f59e0b" data-color="#f59e0b"></div>
            <div class="swatch" style="background:#a855f7" data-color="#a855f7"></div>
            <div class="swatch" style="background:#ec4899" data-color="#ec4899"></div>
            <div class="swatch" style="background:#ffffff" data-color="#ffffff"></div>
          </div>
        </div>

        <div class="size-box">
          <div class="section-title" style="margin-bottom:0;"><span id="brushSizeVal">4px</span></div>
          <input type="range" id="brushSize" min="1" max="32" value="4" title="Brush/Eraser Size ([ and ])" />
        </div>

        <div class="size-box">
          <div class="section-title" style="margin-bottom:0;">Close</div>
          <button id="btnGapCycle" class="gap-btn" title="Automatically close gaps up to this size when using Fill">Off</button>
        </div>
      </aside>

      <!-- Full-Area Center Stage -->
      <main class="stage-container" id="stageContainer">
        <div class="stage-top-left">
          <div class="stage-badge" id="stageBadge">BRUSH (4px) | F1 | 1280×720 | View 100%</div>
          <button id="btnResetView" class="mini-btn" style="display:none;" title="Reset Canvas Zoom & Pan">Reset View</button>
        </div>

        <!-- Framed Viseme Switcher Widget (Appears when Mouth Layer is On) -->
        <div class="mouth-widget" id="mouthWidget">
          <div class="mouth-sheet-pop" id="mouthSheetPop">
            <div style="display:flex; align-items:center; justify-content:space-between;">
              <strong style="font-size:11px;">Viseme Shapes</strong>
              <div style="display:flex; gap:4px;">
                <button id="btnMouthClearShape" class="mini-btn danger" title="Clear current mouth shape to redraw">Clear</button>
                <button id="btnMouthResetShape" class="mini-btn" title="Restore starter shape">Reset</button>
                <button id="btnMouthClosePop" class="mini-btn">✕</button>
              </div>
            </div>
            <div class="mouth-sheet-grid" id="mouthSheetGrid"></div>
            <div class="hint">Click a shape to select it, then use <strong>Draw Shape</strong> (or draw directly on stage) to customize!</div>
          </div>

          <div class="mouth-cycler">
            <button id="btnMouthPrev" class="mouth-arrow-btn" title="Previous Mouth Viseme">◀</button>
            <div class="mouth-frame-box" id="mouthFrameBox" title="Click to view/pick all mouth visemes">
              <canvas id="mouthPreviewCanvas" width="160" height="120"></canvas>
              <span class="mouth-frame-label" id="mouthFrameLabel">Rest</span>
            </div>
            <button id="btnMouthNext" class="mouth-arrow-btn" title="Next Mouth Viseme">▶</button>
          </div>
          <div class="mouth-widget-actions">
            <button id="btnMouthDraw" class="mini-btn" style="flex:1; justify-content:center;" title="Draw replacement directly on stage">Draw</button>
            <button id="btnMouthMove" class="mini-btn" style="flex:1; justify-content:center;" title="Drag mouth position on stage">Move</button>
            <button id="btnMouthAll" class="mini-btn" title="All Viseme Shapes">Shapes</button>
          </div>
        </div>

        <canvas id="stage"></canvas>
      </main>
    </div>

    <!-- Bottom Timeline -->
    <section class="timeline-panel" id="timelinePanel">
      <div class="timeline-header">
        <!-- Left: Timeline & Track Toggles + Camera Popover -->
        <div class="toolbar-group">
          <button id="btnAddFrame" title="Extend timeline by 1 frame">+ Frame</button>
          <button id="btnToggleMouthTrack" title="Show/Hide Mouth Shapes Viseme Layer">Mouth: Off</button>
          <button id="btnToggleBgTrack" title="Show/Hide Background Layer">BG: Off</button>
          <button id="btnToggleAudioTrack" title="Show/Hide Audio Track">Audio: Off</button>
          <button id="btnToggleCamTrack" title="Show/Hide Camera Keyframes on Timeline">CamTrack: Off</button>

          <div class="dropdown-wrap" id="camPopWrap">
            <button id="btnToggleCamPanel" title="Pop out Camera Controls">📷 Camera</button>
            <div class="cam-popover" id="camPopover">
              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span class="section-title" style="margin:0; text-align:left; font-size:10px;">Camera Keyframes</span>
                <button id="btnCloseCamPanel" class="mini-btn" title="Hide Camera Menu">✕</button>
              </div>

              <div>
                <div style="display:flex; gap:5px; margin-bottom:6px;">
                  <button id="btnSetCamKey" class="primary" style="flex:1;">◆ Keyframe</button>
                  <button id="btnDelCamKey" class="danger" title="Remove Camera Keyframe">Remove</button>
                </div>
                <div class="control-row">
                  <label>Easing</label>
                  <select id="camEase" style="flex:1;">
                    <option value="easeInOut">Ease In-Out</option>
                    <option value="linear">Linear</option>
                  </select>
                </div>
              </div>

              <div>
                <div class="control-row">
                  <label>Scale</label>
                  <input type="range" id="camScale" min="20" max="500" value="100" />
                  <span class="val-badge" id="camScaleVal">100%</span>
                </div>
                <div class="control-row">
                  <label>Pan X</label>
                  <input type="range" id="camX" min="-1200" max="1200" value="0" />
                  <span class="val-badge" id="camXVal">0</span>
                </div>
                <div class="control-row">
                  <label>Pan Y</label>
                  <input type="range" id="camY" min="-800" max="800" value="0" />
                  <span class="val-badge" id="camYVal">0</span>
                </div>
                <button id="btnResetCam" style="width:100%; justify-content:center; margin-top:2px;">Reset Camera (100%)</button>
              </div>

              <div class="hint">
                <strong>View Zoom:</strong> Scroll wheel<br>
                <strong>View Pan:</strong> Middle-mouse drag<br>
                <strong>Cam Zoom:</strong> Right-drag (Move)<br>
                <strong>Cam Pan:</strong> Shift+drag (Move)
              </div>
            </div>
          </div>
        </div>

        <!-- Center: Playback Controls -->
        <div class="timeline-header-center">
          <button id="btnRewind" title="First Frame">|&lt;</button>
          <button id="btnPrevFrame" title="Previous Frame (&lt;)">&lt;</button>
          <button id="btnPlay" class="primary" title="Play / Pause (Space)">▶ Play</button>
          <button id="btnNextFrame" title="Next Frame (&gt; — extends at end)">&gt;</button>
          <button id="btnLoop" class="active" title="Toggle Loop">Loop: On</button>
          <select id="fpsSelect" title="Frames Per Second">
            <option value="12" selected>12 FPS</option>
            <option value="24">24 FPS</option>
          </select>
          <span id="frameIndicator" style="min-width: 58px; text-align:center; color: var(--text-muted); font-variant-numeric: tabular-nums;">
            F 1 / 24
          </span>
        </div>

        <!-- Right: Loop & Timeline Zoom Badges -->
        <div class="toolbar-group">
          <span id="loopRangeBadge" style="color:var(--text); font-size:11px;">Loop: All</span>
          <button id="btnResetTimelineZoom" class="mini-btn" style="display:none;" title="Reset Timeline Zoom">Zoom: 1x ✕</button>
        </div>
      </div>

      <div class="timeline-body">
        <div class="track-labels">
          <div class="track-label-loop">
            <span>Loop Range</span>
            <button id="btnClearLoopRange" class="mini-btn" title="Reset Loop Range">Clear</button>
          </div>
          <div class="track-label-spacer">Scrub Frames</div>
          <div class="track-label hidden-track" id="mouthTrackLabel">
            <span class="track-tag" title="Click to draw/move Mouth Shapes"><i style="background:var(--mouth-color)"></i> Mouth</span>
            <div style="display:flex; gap:3px;">
              <button id="btnVisMouth" class="mini-btn" title="Toggle Mouth Visibility">👁</button>
            </div>
          </div>
          <div class="track-label active-draw-layer" id="celTrackLabel">
            <span class="track-tag" title="Click to draw on Animation Frames"><i style="background:var(--cel-color)"></i> Frame-by-Frame</span>
            <button id="btnVisCel" class="mini-btn" title="Toggle Cel Layer">👁</button>
          </div>
          <div class="track-label hidden-track" id="bgTrackLabel">
            <span class="track-tag" title="Click to draw on Background Layer"><i style="background:var(--bg-layer-color)"></i> Background</span>
            <div style="display:flex; gap:3px;">
              <button id="btnAddBgImg" class="mini-btn" title="Load Background Image">+</button>
              <button id="btnVisBg" class="mini-btn" title="Toggle Background Visibility">👁</button>
              <button id="btnClearBg" class="mini-btn danger" title="Clear Background">✕</button>
            </div>
            <input type="file" id="bgFileInput" accept="image/*" style="display:none" />
          </div>
          <div class="track-label hidden-track" id="audioTrackLabel">
            <span class="track-tag"><i style="background:var(--audio-color)"></i> Audio</span>
            <div style="display:flex; gap:3px;">
              <button id="btnRecAudio" class="mini-btn" title="Record Audio from Microphone">● Rec</button>
              <button id="btnAddAudio" class="mini-btn" title="Import Audio File">+</button>
              <button id="btnFitAudio" class="mini-btn" title="Fit Timeline Frames to Audio" style="display:none;">Fit</button>
              <button id="btnMuteAudio" class="mini-btn" title="Mute/Unmute Audio">🔊</button>
              <button id="btnClearAudio" class="mini-btn danger" title="Remove Audio" style="display:none;">✕</button>
            </div>
            <input type="file" id="audioFileInput" accept="audio/*" style="display:none" />
          </div>
          <div class="track-label hidden-track" id="camTrackLabel">
            <span class="track-tag"><i style="background:var(--cam-color)"></i> Camera</span>
            <button id="btnVisCam" class="mini-btn" title="Toggle Camera Preview">👁</button>
          </div>
        </div>

        <div class="timeline-scroll" id="timelineScroll">
          <div class="timeline-grid" id="timelineGrid">
            <div class="loop-row" id="loopRow" title="Drag to select loop range (double-click to clear)">
              <div class="loop-selection-bar" id="loopSelectionBar"></div>
            </div>
            <div class="ruler-row" id="rulerRow"></div>
            <div class="track-row hidden-track" id="mouthTrackRow"></div>
            <div class="track-row" id="celTrackRow"></div>
            <div class="track-row hidden-track" id="bgTrackRow">
              <div class="bg-span-bar" id="bgSpanBar">Background Layer (Drop image here or click to draw)</div>
            </div>
            <div class="track-row hidden-track" id="audioTrackRow">
              <div class="audio-empty-hint" id="audioEmptyHint">Drag &amp; drop audio, click +, or ● Rec from mic</div>
              <div class="audio-rec-badge" id="audioRecBadge">● REC 0.0s</div>
              <canvas id="audioWaveCanvas"></canvas>
              <div class="audio-clip-box" id="audioClipBox">
                <div class="audio-trim-handle left" data-trim="left" title="Trim Start (Snaps to Frame)"></div>
                <div class="audio-clip-label" id="audioClipLabel"></div>
                <div class="audio-trim-handle right" data-trim="right" title="Trim End (Snaps to Frame)"></div>
              </div>
            </div>
            <div class="track-row hidden-track" id="camTrackRow"></div>
            <div class="loop-highlight-overlay" id="loopHighlightOverlay"></div>
            <div class="playhead-line" id="playheadLine"><div class="playhead-cap"></div></div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ==========================================
       PAGE 2: SCENES / STORYBOARD VIEW
       ========================================== -->
  <div class="scenes-view hidden-view" id="scenesView">
    <div class="scenes-player-area">
      <div class="scenes-preview-wrap">
        <canvas id="scenesPreviewCanvas"></canvas>
      </div>
      <div class="scenes-player-bar">
        <button id="btnScenesRewind" title="Rewind All">|&lt;</button>
        <button id="btnScenesPlay" class="primary" title="Play All Scenes (Space)">▶ Play All</button>
        <button id="btnScenesLoop" class="active">Loop: On</button>
        <div class="scenes-scrubber" id="scenesScrubber" title="Scrub across all scenes"></div>
        <span id="scenesFrameReadout" style="min-width:130px; text-align:right; color:var(--text-muted); font-variant-numeric:tabular-nums;">
          Scene 1 • F 1 / 24
        </span>
      </div>
    </div>

    <div class="scenes-board-header">
      <div class="toolbar-group">
        <strong style="font-size:12px;">Scenes Storyboard</strong>
        <button id="btnNewScene" class="primary">+ New Scene</button>
        <span style="color:var(--text-muted); font-size:11px; margin-left:6px;">Drag scenes to reorder • Double-click a scene to edit</span>
      </div>
      <div class="toolbar-group">
