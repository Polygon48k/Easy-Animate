  <script>
    (() => {
      let WORLD_W = 1280;
      let WORLD_H = 720;
      const MOUTH_W = 160;
      const MOUTH_H = 120;
      const VISEME_NAMES = ['Rest', 'MBP', 'AI', 'E', 'O', 'U', 'FV', 'L'];

      function createCelCanvas(w = WORLD_W, h = WORLD_H) {
        const c = document.createElement('canvas');
        c.width = w;
        c.height = h;
        const cctx = c.getContext('2d');
        cctx.imageSmoothingEnabled = false;
        return c;
      }

      // Starter Pixel-Art Mouth Viseme Drawings
      function drawStarterViseme(canvas, idx) {
        const c = canvas.getContext('2d');
        c.imageSmoothingEnabled = false;
        c.clearRect(0, 0, MOUTH_W, MOUTH_H);
        const cx = MOUTH_W / 2;
        const cy = MOUTH_H / 2;

        // Crisp hard-edge ellipse helper
        const fillOval = (ox, oy, rx, ry, col) => {
          c.fillStyle = col;
          for (let y = -ry; y <= ry; y++) {
            for (let x = -rx; x <= rx; x++) {
              if ((x * x) / (rx * rx) + (y * y) / (ry * ry) <= 1) {
                c.fillRect(Math.round(ox + x), Math.round(oy + y), 1, 1);
              }
            }
          }
        };

        const name = VISEME_NAMES[idx];
        if (name === 'Rest') {
          c.fillStyle = '#000000';
          c.fillRect(cx - 28, cy - 2, 56, 4);
          c.fillRect(cx - 32, cy - 4, 5, 3);
          c.fillRect(cx + 27, cy - 4, 5, 3);
        } else if (name === 'MBP') {
          c.fillStyle = '#000000';
          c.fillRect(cx - 30, cy - 3, 60, 6);
          c.fillRect(cx - 34, cy - 5, 4, 10);
          c.fillRect(cx + 30, cy - 5, 4, 10);
        } else if (name === 'AI') {
          fillOval(cx, cy, 34, 28, '#000000');
          fillOval(cx, cy + 2, 28, 22, '#450a0a');
          // Top teeth
          c.fillStyle = '#ffffff';
          c.fillRect(cx - 20, cy - 20, 40, 8);
          // Tongue
          fillOval(cx, cy + 16, 18, 8, '#f43f5e');
        } else if (name === 'E') {
          fillOval(cx, cy, 38, 17, '#000000');
          fillOval(cx, cy, 32, 12, '#ffffff');
          c.fillStyle = '#000000';
          c.fillRect(cx - 30, cy - 1, 60, 2);
        } else if (name === 'O') {
          fillOval(cx, cy, 24, 28, '#000000');
          fillOval(cx, cy + 2, 18, 22, '#450a0a');
          fillOval(cx, cy + 16, 11, 6, '#f43f5e');
        } else if (name === 'U') {
          fillOval(cx, cy, 15, 16, '#000000');
          fillOval(cx, cy, 9, 10, '#450a0a');
        } else if (name === 'FV') {
          fillOval(cx, cy, 32, 14, '#000000');
          c.fillStyle = '#ffffff';
          c.fillRect(cx - 24, cy - 9, 48, 9);
          c.fillStyle = '#f43f5e';
          c.fillRect(cx - 26, cy + 2, 52, 6);
        } else if (name === 'L') {
          fillOval(cx, cy, 30, 22, '#000000');
          fillOval(cx, cy + 2, 24, 16, '#450a0a');
          c.fillStyle = '#ffffff';
          c.fillRect(cx - 18, cy - 15, 36, 7);
          fillOval(cx, cy - 4, 14, 10, '#f43f5e');
        }
      }

      function createDefaultVisemes() {
        return VISEME_NAMES.map((name, i) => {
          const canvas = createCelCanvas(MOUTH_W, MOUTH_H);
          drawStarterViseme(canvas, i);
          return { name, canvas, undoStack: [] };
        });
      }

      function makeScene(name) {
        const s = {
          id: 'sc_' + Math.random().toString(36).slice(2, 10),
          name,
          totalFrames: 24,
          currentFrame: 0,
          loopRange: null,
          cels: new Map(),
          bgLayer: {
            canvas: createCelCanvas(),
            undoStack: [],
            hasInk: false,
            visible: false,
            name: '',
            offsetX: 0,
            offsetY: 0
          },
          mouthLayer: {
            visible: false,
            keys: new Map(), // frame -> { viseme: 0, x, y, scale }
            visemes: createDefaultVisemes()
          },
          cameraKeys: new Map(),
          audio: null
        };
        const c = createCelCanvas();
        s.cels.set(0, { canvas: c, undoStack: [], hasInk: false, duration: 1, offsetX: 0, offsetY: 0 });
        return s;
      }

      const app = {
        mode: 'editor',
        fps: 12,
        loop: true,
        scenes: [makeScene('Scene 1')],
        activeSceneId: null,
        scenesPlaying: false,
        scenesGlobalFrame: 0,
        scenesBoardZoomPx: 220
      };
      app.activeSceneId = app.scenes[0].id;

      const state = {
        isPlaying: false,
        onionSkin: false,
        onionBefore: true,
        onionAfter: false,
        showCelLayer: true,
        applyCamera: true,
        showBgTrack: false,
        showMouthTrack: false,
        showAudioTrack: false,
        showCamTrack: false,
        activeLayer: 'cel', // 'cel' | 'bg' | 'mouth'
        selectedTrack: 'cel', // 'cel' | 'audio' | 'mouth' | 'bg'

        tool: 'brush',
        brushColor: '#000000',
        brushSize: 4,
        fillGapRadius: 0,

        viewZoom: 1,
        viewPanX: 0,
        viewPanY: 0,
        timelineZoom: 1,

        get totalFrames() { return activeScene().totalFrames; },
        set totalFrames(v) { activeScene().totalFrames = v; },
        get currentFrame() { return activeScene().currentFrame; },
        set currentFrame(v) { activeScene().currentFrame = v; },
        get loopRange() { return activeScene().loopRange; },
        set loopRange(v) { activeScene().loopRange = v; },
        get cels() { return activeScene().cels; },
        get bgLayer() { return activeScene().bgLayer; },
        get mouthLayer() { return activeScene().mouthLayer; },
        get cameraKeys() { return activeScene().cameraKeys; },
        get audio() { return activeScene().audio; },
        set audio(v) { activeScene().audio = v; },
        get fps() { return app.fps; },
        set fps(v) { app.fps = v; },
        get loop() { return app.loop; },
        set loop(v) { app.loop = v; }
      };

      function activeScene() {
        return app.scenes.find(s => s.id === app.activeSceneId) || app.scenes[0];
      }

      // DOM References
      const editorView = document.getElementById('editorView');
      const scenesView = document.getElementById('scenesView');
      const btnModeEditor = document.getElementById('btnModeEditor');
      const btnModeScenes = document.getElementById('btnModeScenes');
      const activeSceneLabel = document.getElementById('activeSceneLabel');
      const editorOnionGroup = document.getElementById('editorOnionGroup');

      const stageContainer = document.getElementById('stageContainer');
      const stage = document.getElementById('stage');
      const ctx = stage.getContext('2d');

      const stageBadge = document.getElementById('stageBadge');
      const btnResetView = document.getElementById('btnResetView');
      const frameIndicator = document.getElementById('frameIndicator');
      const camPopover = document.getElementById('camPopover');
      const btnToggleCamPanel = document.getElementById('btnToggleCamPanel');
      const timelinePanel = document.getElementById('timelinePanel');
      const timelineScroll = document.getElementById('timelineScroll');
      const timelineGrid = document.getElementById('timelineGrid');
      const btnResetTimelineZoom = document.getElementById('btnResetTimelineZoom');
      const loopRow = document.getElementById('loopRow');
      const loopSelectionBar = document.getElementById('loopSelectionBar');
      const loopHighlightOverlay = document.getElementById('loopHighlightOverlay');
      const loopRangeBadge = document.getElementById('loopRangeBadge');
      const rulerRow = document.getElementById('rulerRow');
      const celTrackLabel = document.getElementById('celTrackLabel');
      const celTrackRow = document.getElementById('celTrackRow');
      const mouthTrackLabel = document.getElementById('mouthTrackLabel');
      const mouthTrackRow = document.getElementById('mouthTrackRow');
      const bgTrackLabel = document.getElementById('bgTrackLabel');
      const bgTrackRow = document.getElementById('bgTrackRow');
      const bgSpanBar = document.getElementById('bgSpanBar');
      const audioTrackLabel = document.getElementById('audioTrackLabel');
      const audioTrackRow = document.getElementById('audioTrackRow');
      const audioWaveCanvas = document.getElementById('audioWaveCanvas');
      const audioEmptyHint = document.getElementById('audioEmptyHint');
      const audioRecBadge = document.getElementById('audioRecBadge');
      const audioClipBox = document.getElementById('audioClipBox');
      const audioClipLabel = document.getElementById('audioClipLabel');
      const camTrackRow = document.getElementById('camTrackRow');
      const camTrackLabel = document.getElementById('camTrackLabel');
      const playheadLine = document.getElementById('playheadLine');
      const celContextMenu = document.getElementById('celContextMenu');
      const audioContextMenu = document.getElementById('audioContextMenu');

      // Mouth Widget DOM
      const mouthWidget = document.getElementById('mouthWidget');
      const mouthPreviewCanvas = document.getElementById('mouthPreviewCanvas');
      const mouthFrameBox = document.getElementById('mouthFrameBox');
      const mouthFrameLabel = document.getElementById('mouthFrameLabel');
      const mouthSheetPop = document.getElementById('mouthSheetPop');
      const mouthSheetGrid = document.getElementById('mouthSheetGrid');
      const btnMouthDraw = document.getElementById('btnMouthDraw');
      const btnMouthMove = document.getElementById('btnMouthMove');

